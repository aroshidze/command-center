# The Command Center — every variable the hub reads.
#
# Copy this to `.env.local` (which is gitignored) and fill in the three values that have no default.
# `/api/health` names each missing one, so it is the check that tells you when you are done — see
# docs/SETUP.md for the walkthrough.
#
# This file used to contain only CC_SUPPRESS_TELEGRAM while README told you to copy it and fill it in, so
# the documented first step of deploying your own hub produced a file with none of the credentials the hub
# refuses to start without. Every variable below is read by real code, and the file that reads it is named.


# ─── Required. The hub refuses every request until these three are set ────────────────────────────────

# The Neon Postgres connection string. THE HOSTNAME MUST CONTAIN `-pooler` — the direct endpoint also
# appears to work and then exhausts the connection limit under no load at all, because this runs
# serverless. Read by lib/db.ts.
DATABASE_URL=

# What agents authenticate with, sent as `Authorization: Bearer …`. Generate it:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 24 characters or lib/auth.ts treats it as unset and fails closed. This is the token you
# give `cc setup`, and the one that fetches the CLI from /api/agent/cc.mjs.
CC_AGENT_TOKEN=

# What unlocks the page on your phone. Generate it the same way — and make it a DIFFERENT value from
# CC_AGENT_TOKEN. They are unrelated on purpose: three callers, three credentials, so any one can be
# rotated without disturbing the others (lib/auth.ts explains why that is proportionate here).
# You visit `/api/enter?k=<this>` once, ever, and it becomes a year-long cookie.
CC_WEB_TOKEN=


# ─── Optional. Telegram. The hub works completely without it ─────────────────────────────────────────
#
# What you lose by leaving these blank: the one-tap answer from a notification, which is the most useful
# thing here. What you do NOT lose: anything about the record. `/api/health` reports Telegram separately
# and does not count it towards `ok`, because you can always just open the page.
#
# Three minutes with @BotFather — docs/SETUP.md step 2 has the exact messages and the two ways to get it
# wrong. Read by lib/telegram.ts.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Echoed back by Telegram in `X-Telegram-Bot-Api-Secret-Token`, so a forged webhook call cannot answer
# your questions for you. Generate one like the tokens above. Set it before running
# `npm run webhook <your-hub>`.
CC_TELEGRAM_SECRET=


# ─── Optional. Where this hub lives ──────────────────────────────────────────────────────────────────

# The hub's own public address. Used for the "Open the hub" link inside Telegram messages, and by
# scripts/install-into-project.mjs to fetch the AGENTS.md snippet.
#
# /setup does NOT need it — that page derives its URL from the request, so it is correct on a preview
# deployment and on a custom domain with no configuration. Set this only when several addresses resolve to
# the same deployment and you want one to be canonical.
CC_PUBLIC_URL=

# Where this repository is checked out, e.g. /home/you/code/TheCommandCenter.
#
# Used by /setup for the one command that genuinely needs the repo on the machine: the bulk installer.
# Absent, that section says which variable to set instead of printing a path from somebody else's computer.
CC_REPO_PATH=


# ─── Local development only. NEVER set either of these in production ─────────────────────────────────

# When set, the hub sends NOTHING to Telegram.
#
# Running the proof suites against a local server would otherwise push every synthetic question to the
# real phone, because the local server reads the same real bot token. This happened once, a dozen messages
# at a time. tests/prove.mjs refuses to run unless /api/health confirms sending is off.
CC_SUPPRESS_TELEGRAM=yes

# Enables `npm run prove:negative`, which breaks every safety guarantee on purpose and asserts the hub
# reports the failure AND left the database unchanged.
#
# It is independently gated on NODE_ENV !== 'production' by faultsEnabled() in lib/db.ts, so there is no
# single variable that could make a deployed hub lie about a write. Two gates, because one flag standing
# between "reports the truth" and "does not" is one gate too few.
CC_ALLOW_FAULT_INJECTION=yes


# ─── Deliberately not listed above ───────────────────────────────────────────────────────────────────
#
# The ten variables above are every one the HUB reads as configuration — checked against the code rather
# than remembered. Four more exist and none of them belongs in this file:
#
#   CC_FAULT       an internal lever that makes a single write fail, for prove:negative. The suite drives
#                  it per request rather than per process, so setting it here would break every write
#                  until you noticed. Named so it is not a mystery, not offered so it is not a footgun.
#   CC_URL         }  read by cli/cc.mjs, on the AGENT's machine, and normally not set at all — its config
#   CC_TOKEN       }  lives in ~/.command-center/config.json, written by `cc setup`, deliberately never in
#   CC_AGENT       }  a repository. They exist so a cloud agent can be configured with nothing on disk.
#
# Two more — CC_PROVE_URL and CC_FIXTURE_URL — point a test suite at a different server and default to
# localhost. And NODE_ENV is set by the framework, never by you.
